# Backend environment configuration.
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored — NEVER commit real keys. This `.env.example` holds placeholders only.
# These keys are validated at startup by src/core/config/env.config.ts.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Supabase --- (Supabase dashboard -> Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Server-side only — bypasses Row Level Security. The backend uses this to access the DB.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Optional: anon/public key (only needed for direct client-side use or tests).
SUPABASE_ANON_KEY=<your-supabase-anon-public-key>

# Direct Postgres connection string — ONLY needed to run migrations (npm run db:migrate).
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Includes the DB password (a secret). Example shape:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=<your-supabase-postgres-connection-uri>

# --- Clerk --- (Clerk dashboard -> API Keys). Backend SECRET key, server-side only.
# Real value starts with sk_test_ / sk_live_ — paste it into .env, not here.
CLERK_SECRET_KEY=<your-clerk-secret-key>

# --- Upstash Redis --- (rate limiting; Upstash console -> your DB -> REST API)
# OPTIONAL: leave blank to disable rate limiting in local dev. Both must be set to enable.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>
