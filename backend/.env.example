# Backend environment configuration.
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored — NEVER commit real keys. This `.env.example` holds placeholders only.
# These keys are validated at startup by src/core/config/env.config.ts.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Supabase --- (Supabase dashboard -> Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-public-key>
# Server-side only — bypasses Row Level Security. Needed by the ingestion pipeline
# to write content_items. Keep it OUT of any client bundle. (Not yet read by the
# code; uncomment + add to env.config.ts when the ingestion writer lands.)
# SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# --- Clerk --- (Clerk dashboard -> API Keys). Backend SECRET key, server-side only.
# Real value starts with sk_test_ / sk_live_ — paste it into .env, not here.
CLERK_SECRET_KEY=<your-clerk-secret-key>

# --- Upstash Redis --- (rate limiting; Upstash console -> your DB -> REST API)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>
