# Mobile (Expo) environment configuration.
# Copy to `.env` and fill in:  cp .env.example .env
# `.env*` is git-ignored — NEVER commit real keys.
#
# WARNING: Expo embeds every EXPO_PUBLIC_-prefixed var into the app bundle, which
# ships to devices. Put ONLY publishable/public keys here — never a secret key.

# Clerk publishable key (Clerk dashboard -> API Keys). Real value starts with
# pk_test_ / pk_live_. Safe to embed in the client; still keep it in .env, not here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>

# Backend API base URL. Defaults to http://localhost:3000.
# On a physical device use your machine's LAN IP (e.g. http://192.168.1.20:3000),
# since localhost points at the device itself.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
