# Web (Vite) environment configuration.
# Copy to `.env` (or `.env.local`) and fill in:  cp .env.example .env
# `.env*` is git-ignored — NEVER commit real keys.
#
# WARNING: Vite inlines every VITE_-prefixed var into the client bundle, which ships
# to browsers. Put ONLY publishable/public keys here — never a secret key.

# Clerk publishable key (Clerk dashboard -> API Keys). Real value starts with
# pk_test_ / pk_live_. Safe to expose to the client; still keep it in .env, not here.
VITE_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>

# Backend API base URL (optional; defaults to http://localhost:3000).
VITE_API_BASE_URL=http://localhost:3000
